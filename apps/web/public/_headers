# Cloudflare Pages merges every rule whose pattern matches — a more specific
# path does not override a broader one, it adds to it. So `/data/*` plus a
# rule for `/data/manifest.json` gave the manifest two Cache-Control values
# and a day-long cache where five minutes was meant. The dataset directories
# are listed one by one instead, and nothing else matches the manifest.
#
# The data URLs carry a per-level version stamp (`?v=`, see
# scripts/build-manifest.mjs), so a given URL always answers with the same
# bytes. That is what makes a year safe here: a pipeline re-run changes the
# stamp, the URLs change with it, and nothing has to be purged.
#
# A new pipeline output needs its own line here.
/data/zensus/*
  Cache-Control: public, max-age=31536000, immutable
/data/afterdark/*
  Cache-Control: public, max-age=31536000, immutable
/data/energy/*
  Cache-Control: public, max-age=31536000, immutable
/data/rain/*
  Cache-Control: public, max-age=31536000, immutable
/data/land/*
  Cache-Control: public, max-age=31536000, immutable
/data/forest/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest is the mutable entry point, and now the only rule matching it.
# Everything else under /data/ — cities, boundary, states, outline — falls to
# the platform default (max-age=0, must-revalidate), which is what mutable,
# non-content-addressed files should get.
/data/manifest.json
  Cache-Control: public, max-age=300, must-revalidate

# Hashed Vite bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The font files are stable but their names are not content-hashed, so this
# is a week rather than a promise of immutability. Without a rule they were
# revalidated on every repeat visit — eleven conditional requests for files
# that have not changed since they were vendored.
/fonts/*
  Cache-Control: public, max-age=604800

# The site loads nothing from anywhere else: no CDN, no analytics, no embed,
# no font host. The policy says exactly that, so anything injected later has
# nowhere to send data to.
#
#   style-src needs 'unsafe-inline' because React writes style attributes
#     (the legend gradient, the timeline read-out position). Attribute styles
#     cannot be nonced, and a hash does not apply to them.
#   worker-src needs blob: — Vite emits the tile worker as a blob URL.
#   img-src needs data: and blob: — the poster preview is a data URL and the
#     export hands back a blob.
#   connect-src is 'self' only: the data lives beside the app.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
