# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Build output
dist/
*.tsbuildinfo

# Pipeline output (see pipelines/*/README.md, then: npm run build:manifest)
apps/web/public/data/

# Pipeline working data (large downloads / intermediate files)
pipelines/**/work/
pipelines/**/downloads/

# Local secrets (EARTHDATA_TOKEN etc.) - never commit
.env
.env.*
!.env.example

# Editor and tooling state: local to whoever is working, not part of the
# project.
*.log
.DS_Store
.idea/
.vscode/
.claude/
.cursor/
.continue/
.windsurf/
.aider*

# Local visual-regression baselines (scripts/visual-check.cjs)
.visual/
