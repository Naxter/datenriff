# Copy this file to `.env` and fill in what you need. `.env` is gitignored.
#
# Nothing here is required to run the atlas: `npm run demo` seeds a synthetic
# dataset, and four of the six pipelines download from open endpoints without
# credentials. Only AFTER DARK needs a token.

# NASA Earthdata bearer token, for the Black Marble night-lights pipeline
# (pipelines/black-marble). Free account, then Profile → Generate Token:
# https://urs.earthdata.nasa.gov/
# EARTHDATA_TOKEN=

# Canonical host, only for trying a different one without committing to it.
# The real default lives in scripts/build-pages.mjs, because `npm run build`
# regenerates the standing pages and would otherwise put the default back.
# SITE_URL=https://datenriff.de

# --- Check tuning (scripts/check-picking.cjs, scripts/screenshot-*.cjs) ---
# PICK_GPU=1          # drive the real GPU instead of SwiftShader
# PICK_WAIT_MS=12000  # raise on slow machines; SwiftShader needs ~25000
# SHOT_DPR=2          # device pixel ratio for prototype screenshots
